{
  "Paths": {
    "DataDir": "./extracted_data",
    "ParquetDir": "./parquet_data",
    "OutputDir": "./cnpj_shards",
    "DownloadDir": "./downloads"
  },
  "Rclone": {
    "RemoteBase": "Opencnpj:opencnpj/files",
    "Transfers": 4,
    "MaxConcurrentUploads": 1,
    "BufferSize": "16M",
    "UploadVerificationRetries": 3,
    "UploadVerificationDelaySeconds": 15
  },
  "DuckDb": {
    "UseInMemory": false,
    "ThreadsPragma": 1,
    "MemoryLimit": "4GB",
    "EngineThreads": 1,
    "PreserveInsertionOrder": false,
    "PartitionedWriteMaxOpenFiles": 16
  },
  "Shards": {
    "PrefixLength": 3,
    "RemoteDir": "shards",
    "MaxParallelProcessing": 1,
    "QueryBatchSize": 1,
    "QueryRangeFanOut": 5,
    "QsaMaterializationRangeFanOut": 2
  },
  "Downloader": {
    "ParallelDownloads": 2,
    "PublicShareRoot": "https://arquivos.receitafederal.gov.br/public.php/dav/files/YggdBLfdninEJX9/"
  },
  "CnoIntegration": {
    "Enabled": true,
    "PublicShareRoot": "https://arquivos.receitafederal.gov.br/public.php/dav/files/gn672Ad4CF8N6TK/Dados/Cadastros/CNO/",
    "ZipFileName": "cno.zip",
    "RefreshHours": 24
  },
  "RntrcIntegration": {
    "Enabled": true,
    "PackageShowUrl": "https://dados.antt.gov.br/api/3/action/package_show?id=b4a055d1-97a2-46f1-9461-cb17fbc6b6b3",
    "RefreshHours": 24
  },
  "PortalTransparenciaIntegration": {
    "Enabled": true,
    "CatalogBaseUrl": "https://portaldatransparencia.gov.br/download-de-dados",
    "EnabledDatasets": [
      "favorecidos_pj",
      "ceis",
      "cepim",
      "cnep",
      "acordos_leniencia",
      "licitacoes",
      "contratos",
      "renuncias_fiscais",
      "notas_fiscais",
      "convenios",
      "emendas_parlamentares",
      "emendas_documentos"
    ],
    "DuckDbThreads": 1,
    "DuckDbMemoryLimit": "512MB",
    "DuckDbMaxTempDirectorySize": "20GB",
    "ProcessingPartitions": 64
  },
  "BigQuery": {
    "Enabled": false,
    "ProjectId": "",
    "Dataset": "public",
    "TablePrefix": "",
    "Location": "",
    "BqExecutable": "bq",
    "KeepStagingTables": false,
    "CompactionThreads": 1,
    "CompactionMemoryLimit": "4GB",
    "CompactionMaxTempDirectorySize": "100GB"
  }
}
